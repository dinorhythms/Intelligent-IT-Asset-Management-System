# Copy to .env and adjust as needed
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=5001
AI_SERVICE_DEBUG=false
AI_SERVICE_LOG_LEVEL=INFO

# Model
AI_MODEL_PATH=models/predictive_model.joblib
AI_MAX_RUL_DAYS=400

# Security (share JWT_SECRET with the NestJS backend)
AI_SERVICE_API_KEY=change-me-api-key
AI_SERVICE_JWT_SECRET=dev-secret

# Maintenance parameters
MAINTENANCE_INTERVAL_DAYS=90
SERVICE_HOURS_CYCLE=500

# Anomaly thresholds
TEMPERATURE_THRESHOLD=80
CPU_THRESHOLD=90
VIBRATION_THRESHOLD=5.0
